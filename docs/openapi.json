{
  "openapi": "3.0.3",
  "info": {
    "title": "CampusHub Reservation API",
    "version": "1.2.0",
    "description": "CS 5500 Lab 4: resource reservations persisted in MongoDB through Mongoose, with catalog availability filtering and reservation status transitions. Responses are direct objects/arrays and errors are {code, message}. Resource and reservation ids are MongoDB ObjectIds. There is no authentication. Unmatched routes return 404 ErrorResponse. Calendar validity and interval ordering are checked at runtime in addition to schema formats.",
    "license": {
      "name": "UNLICENSED"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local development server (binds to 127.0.0.1)"
    }
  ],
  "tags": [
    {
      "name": "Resources",
      "description": "Campus resource catalog."
    },
    {
      "name": "Reservations",
      "description": "Local resource bookings."
    },
    {
      "name": "Health",
      "description": "HTTP liveness."
    }
  ],
  "security": [],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["Health"],
        "summary": "Check HTTP service liveness",
        "description": "Does not connect to or probe a database.",
        "responses": {
          "200": {
            "description": "The HTTP service is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok",
                  "timestamp": "2026-10-01T10:00:00.000Z"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/resources": {
      "get": {
        "operationId": "listResources",
        "tags": ["Resources"],
        "summary": "List resources, optionally filtered by type and availability",
        "description": "Returns the resource catalog stored in MongoDB, ordered by id. STUDY_ROOM is a query-only alias for ROOM to support the assignment curl example. type and isAvailable may be combined and are then applied together. Unknown query parameters and repeated values are rejected.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Exactly one non-empty resource type; STUDY_ROOM maps to ROOM.",
            "schema": {
              "type": "string",
              "enum": ["ROOM", "EQUIPMENT", "LAB", "STUDY_ROOM"]
            }
          },
          {
            "name": "isAvailable",
            "in": "query",
            "required": false,
            "description": "Exactly one of the literal strings true or false; other spellings are rejected.",
            "schema": {
              "type": "string",
              "enum": ["true", "false"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching resources; an array, without an envelope.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Resource"
                  }
                },
                "example": [
                  {
                    "id": "000000000000000000000101",
                    "name": "Study Room 302",
                    "type": "ROOM",
                    "location": "Library, Floor 3",
                    "isAvailable": true
                  }
                ]
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/reservations": {
      "post": {
        "operationId": "createReservation",
        "tags": ["Reservations"],
        "summary": "Create a time-slotted reservation",
        "description": "Persists a CONFIRMED reservation in MongoDB. Any non-cancelled reservation for the same resource with an overlapping time interval causes 409; bookings for one resource are serialized within a single server process. A resourceId that is not an existing resource's ObjectId returns 404. A syntactically valid userId is accepted without a user database. Unknown query parameters are rejected. Only uncompressed JSON request bodies are supported; compressed Content-Encoding values return 415.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateReservationRequest"
              },
              "example": {
                "resourceId": "000000000000000000000101",
                "userId": "user-456",
                "startTime": "2026-10-01T10:00:00Z",
                "endTime": "2026-10-01T11:00:00Z"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The newly created reservation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "id": "6720f3c2a1b4c5d6e7f80912",
                  "resourceId": "000000000000000000000101",
                  "userId": "user-456",
                  "startTime": "2026-10-01T10:00:00.000Z",
                  "endTime": "2026-10-01T11:00:00.000Z",
                  "status": "CONFIRMED"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/reservations/user/{userId}": {
      "get": {
        "operationId": "listUserReservations",
        "tags": ["Reservations"],
        "summary": "List every reservation for one user",
        "description": "Returns all reservations belonging to the requested user, in creation (ObjectId) order, including CANCELLED reservations and reservations whose endTime has already passed, so a cancellation stays observable. The optional status parameter narrows the list to one status. Returns [] when none exist. Unknown query parameters are rejected. Changed in 1.2.0: version 1.1.0 returned only non-cancelled reservations ending in the future.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "description": "The student identifier.",
            "schema": {
              "$ref": "#/components/schemas/Identifier"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Exactly one reservation status; omit to return every reservation.",
            "schema": {
              "type": "string",
              "enum": ["PENDING", "CONFIRMED", "CANCELLED"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every reservation for this user, in creation (ObjectId) order.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reservation"
                  }
                },
                "example": [
                  {
                    "id": "6720f3c2a1b4c5d6e7f80912",
                    "resourceId": "000000000000000000000101",
                    "userId": "user-456",
                    "startTime": "2026-10-01T10:00:00.000Z",
                    "endTime": "2026-10-01T11:00:00.000Z",
                    "status": "CONFIRMED"
                  }
                ]
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/reservations/{id}/cancel": {
      "patch": {
        "operationId": "cancelReservation",
        "tags": ["Reservations"],
        "summary": "Cancel a reservation",
        "description": "Transitions a PENDING or CONFIRMED reservation to CANCELLED and returns it. The released interval stops blocking overlap checks immediately, so the slot becomes bookable again. Cancelling an already CANCELLED reservation is a 409 INVALID_STATE_TRANSITION rather than a silent no-op. An id that is not an existing reservation's ObjectId returns 404. The request takes no body; unknown query parameters are rejected.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The reservation's ObjectId.",
            "schema": {
              "$ref": "#/components/schemas/ObjectId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The reservation after the transition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "id": "6720f3c2a1b4c5d6e7f80912",
                  "resourceId": "000000000000000000000101",
                  "userId": "user-456",
                  "startTime": "2026-10-01T10:00:00.000Z",
                  "endTime": "2026-10-01T11:00:00.000Z",
                  "status": "CANCELLED"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/ReservationNotFound"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/reservations/{id}/confirm": {
      "patch": {
        "operationId": "confirmReservation",
        "tags": ["Reservations"],
        "summary": "Confirm a pending reservation",
        "description": "Transitions a PENDING reservation to CONFIRMED and returns it. CONFIRMED and CANCELLED are both rejected with 409 INVALID_STATE_TRANSITION: CANCELLED is terminal, and a reservation cannot be confirmed twice. An id that is not an existing reservation's ObjectId returns 404. The request takes no body; unknown query parameters are rejected.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The reservation's ObjectId.",
            "schema": {
              "$ref": "#/components/schemas/ObjectId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The reservation after the transition.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                },
                "example": {
                  "id": "6720f3c2a1b4c5d6e7f80912",
                  "resourceId": "000000000000000000000101",
                  "userId": "user-456",
                  "startTime": "2026-10-01T10:00:00.000Z",
                  "endTime": "2026-10-01T11:00:00.000Z",
                  "status": "CONFIRMED"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/ReservationNotFound"
          },
          "409": {
            "$ref": "#/components/responses/StateConflict"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Identifier": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "ObjectId": {
        "type": "string",
        "pattern": "^[0-9a-f]{24}$",
        "description": "MongoDB ObjectId as 24 lowercase hexadecimal characters.",
        "example": "000000000000000000000101"
      },
      "Timestamp": {
        "type": "string",
        "format": "date-time",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$",
        "description": "Calendar-valid ISO 8601 / RFC 3339 timestamp with uppercase T, seconds, Z or numeric offset, and optional 1\u20133 fractional digits. Years 0001\u20139999; no leap seconds. Responses normalize to UTC milliseconds.",
        "example": "2026-10-01T10:00:00Z"
      },
      "User": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Identifier"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S"
          }
        },
        "description": "Minimal user data model for future persistence; no user management or authentication endpoint is implemented."
      },
      "Resource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "location", "isAvailable"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "enum": ["ROOM", "EQUIPMENT", "LAB"]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "isAvailable": {
            "type": "boolean",
            "description": "Operational availability, not whether every time slot is free."
          }
        }
      },
      "CreateReservationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceId", "userId", "startTime", "endTime"],
        "properties": {
          "resourceId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "userId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "startTime": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "endTime": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "description": "Client-supplied fields only. resourceId should be a Resource ObjectId; other syntactically valid identifiers match no resource and return 404. startTime must be earlier than endTime. The server assigns id and status. Past intervals are allowed; they are excluded from active results once ended."
      },
      "Reservation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resourceId", "userId", "startTime", "endTime", "status"],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "resourceId": {
            "$ref": "#/components/schemas/ObjectId"
          },
          "userId": {
            "$ref": "#/components/schemas/Identifier"
          },
          "startTime": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "endTime": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "status": {
            "type": "string",
            "enum": ["PENDING", "CONFIRMED", "CANCELLED"]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "RESOURCE_NOT_FOUND",
              "RESOURCE_UNAVAILABLE",
              "DOUBLE_BOOKING",
              "RESERVATION_NOT_FOUND",
              "INVALID_STATE_TRANSITION",
              "NOT_FOUND",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "INTERNAL_ERROR"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "timestamp"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "timestamp": {
            "$ref": "#/components/schemas/Timestamp"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid query, path, JSON body, timestamp, or interval.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "VALIDATION_ERROR",
              "message": "Request input is invalid."
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested route or resource does not exist.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "RESOURCE_NOT_FOUND",
              "message": "The resource was not found."
            }
          }
        }
      },
      "Conflict": {
        "description": "The resource is unavailable or a non-cancelled reservation overlaps this half-open interval [startTime, endTime). Adjacent intervals are allowed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "overlap": {
                "value": {
                  "code": "DOUBLE_BOOKING",
                  "message": "Resource is already reserved for this time slot."
                }
              },
              "unavailable": {
                "value": {
                  "code": "RESOURCE_UNAVAILABLE",
                  "message": "The resource is unavailable."
                }
              }
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "Request body exceeds the 16 KiB JSON limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "PAYLOAD_TOO_LARGE",
              "message": "The JSON body exceeds the 16 KiB limit."
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Reservation creation requires uncompressed application/json with supported JSON character encoding.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "UNSUPPORTED_MEDIA_TYPE",
              "message": "Content-Type must be application/json."
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error; no internal details are exposed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "INTERNAL_ERROR",
              "message": "An unexpected error occurred."
            }
          }
        }
      },
      "ReservationNotFound": {
        "description": "No reservation exists with this id.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "RESERVATION_NOT_FOUND",
              "message": "The reservation was not found."
            }
          }
        }
      },
      "StateConflict": {
        "description": "The reservation's current status does not allow the requested transition.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "code": "INVALID_STATE_TRANSITION",
              "message": "A CANCELLED reservation cannot be cancelled."
            }
          }
        }
      }
    }
  }
}
